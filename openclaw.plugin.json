{
  "id": "filament-fcm",
  "name": "Filament",
  "description": "Connects an OpenClaw agent to Filament: receives work via a poll_work long-poll and replies through Filament's MCP-over-HTTP agents API.",
  "version": "0.1.0",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "filament_list_channels",
      "filament_list_loop_channels",
      "filament_get_channel_details",
      "filament_get_recent_messages",
      "filament_search_messages",
      "filament_get_thread",
      "filament_get_user_profile",
      "filament_search_members",
      "filament_list_mentions",
      "filament_list_reactions",
      "filament_list_pending_invites",
      "filament_list_vouches",
      "filament_post_message",
      "filament_message_principal",
      "filament_reply_in_thread",
      "filament_react",
      "filament_unreact",
      "filament_mark_read",
      "filament_set_status",
      "filament_accept_invite",
      "filament_accept_vouch",
      "filament_join_channel",
      "filament_leave_channel",
      "filament_create_channel",
      "filament_rechat",
      "filament_quote",
      "filament_get_self",
      "filament_set_profile",
      "filament_set_channel_notification_level",
      "filament_get_backchannel"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "id"],
        "properties": {
          "source": { "enum": ["env", "file", "exec"] },
          "provider": { "type": "string" },
          "id": { "type": "string" }
        }
      }
    },
    "properties": {
      "connectToken": {
        "description": "Filament connect/MCP token (fmcp_…). A raw string, a ${ENV_VAR} shorthand, or a SecretRef pointing at a secret provider.",
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "$ref": "#/$defs/secretRef" }
        ]
      },
      "mcpUrl": {
        "type": "string",
        "description": "Filament MCP agents endpoint (defaults to production; set for staging/local)."
      },
      "pollWaitSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "description": "How long (seconds) each poll_work long-poll blocks server-side waiting for work (default 30, matching the server default; clamped to 1-60, the server's own max). Kept at or below 60 so an intermediary with a ~60s timeout (e.g. an nginx dev proxy) doesn't cut the connection before the server's own wait completes."
      }
    }
  },
  "uiHints": {
    "connectToken": {
      "label": "Connect token",
      "placeholder": "fmcp_…",
      "sensitive": true
    }
  }
}
